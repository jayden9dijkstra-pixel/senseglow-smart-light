{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bepcnohdxsoxhdjlviqu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "senseglow-mcp",
      "version": "0.3.0",
      "title": "SenseGlow Shop"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List all SenseGlow products currently sold on senseglow.shop, with price range, description, and product page URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Get full details for a single SenseGlow product by its handle (e.g. 'senseglow_wave'): description, images, variants (color/size), prices, availability, and product page URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1,
              "description": "The product handle, e.g. 'senseglow_wave' or 'senseglow_ambient_motion_bar'."
            }
          },
          "required": [
            "handle"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search SenseGlow products by keyword (matches title, description, tags). Returns summaries with prices and product page URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search keywords, e.g. 'wave', 'solar lantern', 'motion sensor'."
            },
            "limit": {
              "default": 10,
              "description": "Maximum results to return (1-20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_orders",
        "title": "Get orders (admin)",
        "description": "Orders in a date range: number, time, total, line items, status, attribution (gclid yes/no, utm). No personal data. Country is not stored and returns null. Admin only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Startdatum YYYY-MM-DD"
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Einddatum YYYY-MM-DD (inclusief), max 90 dagen na start"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 250
            }
          },
          "required": [
            "date_from",
            "date_to"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_sales_summary",
        "title": "Sales summary (admin)",
        "description": "Revenue, order count, average order value, per product and per day. Test orders are excluded. Admin only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Startdatum YYYY-MM-DD"
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Einddatum YYYY-MM-DD (inclusief), max 90 dagen na start"
            }
          },
          "required": [
            "date_from",
            "date_to"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_funnel",
        "title": "Funnel (admin)",
        "description": "Sessions, view_item, add_to_cart, begin_checkout from own site events (internal traffic excluded) and purchases from Shopify orders. Abandoned carts = add_to_cart sessions without begin_checkout. Admin only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Startdatum YYYY-MM-DD"
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Einddatum YYYY-MM-DD (inclusief), max 90 dagen na start"
            }
          },
          "required": [
            "date_from",
            "date_to"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_attribution",
        "title": "Attribution (admin)",
        "description": "Orders and revenue per utm_campaign and per source, based on stored gclid/utm. Test orders excluded. Admin only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Startdatum YYYY-MM-DD"
            },
            "date_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Einddatum YYYY-MM-DD (inclusief), max 90 dagen na start"
            }
          },
          "required": [
            "date_from",
            "date_to"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_ads_daily",
        "title": "Google Ads daily (admin)",
        "description": "Daily Google Ads cost per campaign from table ads_daily (filled by your Google Ads Script). Admin only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date_from": {
              "type": "string",
